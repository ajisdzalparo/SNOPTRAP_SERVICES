# Copy to .env and fill real values (do NOT commit .env).
# TURN relay for WebRTC. The viewer page and coturn both read these.
TURN_URL=turn:YOUR_VPS_PUBLIC_IP:3478
TURN_USER=snoop
TURN_PASS=change-me-to-a-strong-password
# Public IP coturn advertises for relay candidates (usually the VPS public IP).
TURN_EXTERNAL_IP=YOUR_VPS_PUBLIC_IP
